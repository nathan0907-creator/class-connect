{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$cid": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "typing": {
      "$cid": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && newData.val() <= now + 5000"
        }
      }
    }
  }
}
