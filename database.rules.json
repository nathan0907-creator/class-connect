{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$cid": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "typing": {
      "$cid": {
        "$channel": {
          ".read": "auth != null && ($channel === 'messages' || $channel === 'mixed_messages' || $channel === 'staff_messages')",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() <= now + 5000"
          }
        }
      }
    }
  }
}
