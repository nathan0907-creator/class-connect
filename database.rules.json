{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$cid": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $cid.matches(/^[A-Za-z0-9]{20}$/)",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "typing": {
      "$cid": {
        "$channel": {
          ".read": "auth != null && ($channel === 'messages' || $channel === 'mixed_messages' || $channel === 'staff_messages' || $channel === 'announcements')",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $cid.matches(/^[A-Za-z0-9]{20}$/) && ($channel === 'messages' || $channel === 'mixed_messages' || $channel === 'staff_messages' || $channel === 'announcements')",
            ".validate": "newData.isNumber() && newData.val() <= now + 5000"
          }
        }
      }
    },
    "boards": {
      "$cid": {
        ".read": "auth != null && $cid.matches(/^[A-Za-z0-9]{20}$/)",
        "cleared_at": {
          ".write": "auth != null && $cid.matches(/^[A-Za-z0-9]{20}$/)",
          ".validate": "newData.isNumber() && newData.val() <= now + 5000"
        },
        "strokes": {
          "$sid": {
            ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid && $cid.matches(/^[A-Za-z0-9]{20}$/)",
            ".validate": "newData.hasChildren(['by', 'e', 'iv', 'ct', 't'])",
            "by": { ".validate": "newData.isString()" },
            "e": { ".validate": "newData.isNumber()" },
            "iv": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "ct": { ".validate": "newData.isString() && newData.val().length <= 40000" },
            "t": { ".validate": "newData.isNumber() && newData.val() <= now + 5000" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
