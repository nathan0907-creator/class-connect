{
  "name": "Class Connect",
  "short_name": "Class Connect",
  "description": "La messagerie chiffrée de ta classe : chat, votes d'emploi du temps et espace délégué.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#05030f",
  "theme_color": "#05030f",
  "icons": [
    {
      "src": "img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "application/pdf"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Chat",
      "url": "./?panel=chat"
    },
    {
      "name": "Emploi du temps",
      "url": "./?panel=timetable"
    },
    {
      "name": "Révisions IA",
      "url": "./?panel=study"
    }
  ]
}
