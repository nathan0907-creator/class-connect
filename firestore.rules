rules_version = '2';

// ============================================================================
//  Class Connect — règles de sécurité Firestore
//  Toute l'autorisation est vérifiée ICI, côté serveur Google : le code du site
//  ne fait qu'envoyer des requêtes que ces règles acceptent ou refusent.
//  Le contenu des messages et des fichiers est chiffré de bout en bout : même
//  avec un accès à la base, il est illisible.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userPath(id) { return /databases/$(database)/documents/users/$(id); }
    function classPath(cid) { return /databases/$(database)/documents/classes/$(cid); }
    function me() { return get(userPath(uid())).data; }
    function isActiveMember(cid) { return signedIn() && exists(userPath(uid())) && me().class_id == cid && me().status == 'active'; }
    // A deputy may stand in for the delegate for a limited time ("passation"), with the same powers.
    function isDelegate(cid) {
      return isActiveMember(cid) && (me().role == 'delegate'
        || (me().role == 'deputy' && me().get('acting_until', null) is timestamp && me().acting_until > request.time));
    }
    function isTeacher(cid) { return isActiveMember(cid) && me().role == 'teacher'; }
    function isPrincipal(cid) { return isTeacher(cid) && me().get('principal', false) == true; }
    function isDeputy(cid) { return isActiveMember(cid) && me().role == 'deputy'; }
    function isStudent(cid) { return isActiveMember(cid) && me().role != 'teacher'; }
    function canPublishCourses(cid) { return isActiveMember(cid) && (me().role in ['delegate', 'deputy', 'teacher'] || me().get('trusted', false) == true); }
    function notPrincipal(d) { return d.get('principal', false) == false; }

    // Chat channels: "messages" = students only, "staff_messages" = teachers only, "mixed_messages" = everyone,
    // "announcements" = read by everyone, written by delegates / deputies / teachers.
    function isChannel(ch) { return ch in ['messages', 'mixed_messages', 'staff_messages', 'announcements']; }
    function canChannel(cid, ch) {
      return (ch == 'messages' && isStudent(cid))
        || (ch == 'staff_messages' && isTeacher(cid))
        || (ch in ['mixed_messages', 'announcements'] && isActiveMember(cid));
    }
    function isStaff(cid) { return isDelegate(cid) || isDeputy(cid) || isTeacher(cid); }
    // Writing: in the announcements channel, other members may only post a timetable alert ("prof absent"…).
    function canPost(cid, ch, d) {
      return canChannel(cid, ch) && (ch != 'announcements' || isStaff(cid) || d.get('kind', '') == 'alert');
    }
    // Pin / delete others' messages: delegates and deputies for students, teachers for the staff room.
    function moderates(cid, ch) {
      return (ch == 'messages' && (isDelegate(cid) || isDeputy(cid)))
        || (ch == 'staff_messages' && isTeacher(cid))
        || (ch in ['mixed_messages', 'announcements'] && isStaff(cid));
    }
    // Reports: delegates for the students' channels, teachers for theirs, and head teachers receive ALL reports.
    function handlesReports(cid, ch) {
      return isPrincipal(cid)
        || (ch in ['messages', 'mixed_messages', 'announcements'] && isDelegate(cid))
        || (ch in ['mixed_messages', 'staff_messages', 'announcements'] && isTeacher(cid));
    }
    function notTrusted(d) { return d.get('trusted', false) == false; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanged(keys) { return changed().hasOnly(keys); }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    // Colours end up in CSS: only "#rrggbb" (anything else could load an outside image in every classmate's browser).
    function validColor(c) { return c is string && c.matches('^#[0-9a-fA-F]{6}$'); }
    function hhmm(v) { return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }

    function validSlot(d) {
      return d.keys().hasOnly(['day', 'start_at', 'end_at', 'subject', 'teacher', 'room', 'color', 'week'])
        && d.keys().hasAll(['day', 'start_at', 'end_at', 'subject', 'teacher', 'room', 'color'])
        && d.get('week', 'A') in ['A', 'B']
        && d.day is int && d.day >= 0 && d.day <= 5
        && hhmm(d.start_at) && hhmm(d.end_at) && d.start_at < d.end_at
        && str(d.subject, 1, 40) && str(d.teacher, 0, 40) && str(d.room, 0, 20)
        && d.color is string && d.color.matches('^#[0-9a-fA-F]{6}$');
    }

    // ---------------------------------------------------------------- usernames (pseudo → e-mail de connexion)
    match /usernames/{name} {
      allow get: if true;               // needed to sign in with a pseudo
      allow list: if false;             // no enumeration
      // Readable by anyone: it may only hold the synthetic address of a pseudo account (reserved domain, derived from
      // the pseudo). A real e-mail is never stored here: those accounts log in with their e-mail.
      allow create: if signedIn()
        && name.matches('^[a-z0-9_.-]{3,24}$')
        && request.resource.data.uid == uid()
        && (request.resource.data.keys().hasOnly(['uid'])
            || (request.resource.data.keys().hasOnly(['uid', 'email'])
                && request.resource.data.email == name + '@pseudo.class-connect.invalid'
                && request.auth.token.email == request.resource.data.email));
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == uid();   // account deletion (RGPD)
    }

    // ---------------------------------------------------------------- e-mails (to know if an address already has an account)
    match /emails/{email} {
      allow get: if true;
      allow list: if false;             // no enumeration
      allow create: if signedIn() && email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid();
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // ---------------------------------------------------------------- push notification tokens (one per device)
    // Only read by the "pushOnMessage" Cloud Function (admin access); never readable from the site.
    match /push_tokens/{id} {
      allow read: if false;
      allow create, update: if signedIn()
        && (resource == null || resource.data.uid == uid())
        && request.resource.data.keys().hasOnly(['uid', 'token', 'updated_at'])
        && request.resource.data.uid == uid()
        && str(request.resource.data.token, 20, 4096)
        && request.resource.data.updated_at == request.time;
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // ---------------------------------------------------------------- personal data (grade book), encrypted with my own key
    match /private_data/{userId} {
      allow read, delete: if signedIn() && userId == uid();
      allow create, update: if signedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(['iv', 'ciphertext', 'updated_at'])
        && str(request.resource.data.iv, 10, 32) && str(request.resource.data.ciphertext, 10, 300000)
        && request.resource.data.updated_at == request.time;
    }

    // ---------------------------------------------------------------- private keys (encrypted with the password)
    match /private/{userId} {
      allow read: if signedIn() && userId == uid();
      allow create, update: if signedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(['enc_salt', 'enc_private_key', 'priv_iv'])
        && str(request.resource.data.enc_private_key, 10, 1000);
      allow delete: if signedIn() && userId == uid();
    }

    // ---------------------------------------------------------------- users
    function userKeys() {
      return request.resource.data.keys().hasOnly(['username', 'display_name', 'color', 'public_key', 'class_id',
        'role', 'status', 'created_at', 'invite_code', 'trusted', 'principal', 'muted_until', 'acting_until']);
    }
    // Leaving a class (or being removed) ends any mute and any handover: nothing carries over to another class.
    function cleared(a) { return a.get('muted_until', null) == null && a.get('acting_until', null) == null; }
    function selfUpdate(userId) {
      let b = resource.data;
      let a = request.resource.data;
      return userId == uid() && userKeys() && a.username == b.username && a.created_at == b.created_at && (
        // profile (an active member's new key goes through the branch below)
        (onlyChanged(['display_name', 'color', 'public_key']) && str(a.display_name, 1, 40) && validColor(a.color)
            && str(a.public_key, 50, 400) && (a.public_key == b.public_key || b.status != 'active' || b.role == 'delegate'))
        // new key (password reset) → back to "pending": a delegate re-approves before the class keys are shared again
        || (onlyChanged(['public_key', 'status']) && b.status == 'active' && a.status == 'pending' && b.role != 'delegate'
            && str(a.public_key, 50, 400))
        // join a class with an invite code → pending (as student or teacher, depending on the code)
        || (onlyChanged(['class_id', 'status', 'role', 'invite_code']) && b.class_id == null
            && a.status == 'pending' && a.invite_code is string
            && get(/databases/$(database)/documents/invites/$(a.invite_code)).data.class_id == a.class_id
            && a.role == get(/databases/$(database)/documents/invites/$(a.invite_code)).data.get('role', 'student'))
        // create a class (same batch) → delegate
        || (onlyChanged(['class_id', 'status', 'role']) && b.class_id == null
            && a.status == 'active' && a.role == 'delegate' && a.class_id is string
            && !exists(classPath(a.class_id))
            && getAfter(classPath(a.class_id)).data.created_by == uid())
        // leave the class (the "trusted" flag is dropped)
        || (onlyChanged(['class_id', 'status', 'role', 'invite_code', 'trusted', 'principal', 'muted_until', 'acting_until']) && a.class_id == null && a.status == 'none'
            && a.role == 'student' && notTrusted(a) && notPrincipal(a) && cleared(a))
      );
    }
    function delegateUpdate(userId) {
      let b = resource.data;
      let a = request.resource.data;
      return userId != uid() && b.class_id != null && isDelegate(b.class_id) && (
        (onlyChanged(['status']) && b.status == 'pending' && a.status == 'active')
        || (onlyChanged(['class_id', 'status', 'role', 'trusted', 'principal', 'muted_until', 'acting_until']) && a.class_id == null && a.status == 'none'
            && a.role == 'student' && notTrusted(a) && notPrincipal(a) && cleared(a))
        // student roles: élève / suppléant / délégué
        || (onlyChanged(['role']) && b.status == 'active' && b.role != 'teacher' && a.role in ['student', 'deputy', 'delegate'])
        // a member becomes a teacher (or a teacher goes back to student): no "trusted" / "prof principal" carried over
        || (onlyChanged(['role', 'trusted', 'principal']) && b.status == 'active' && notTrusted(a) && notPrincipal(a)
            && ((b.role != 'teacher' && a.role == 'teacher') || (b.role == 'teacher' && a.role == 'student')))
        // head teacher ("prof principal"): receives every report
        || (onlyChanged(['principal']) && b.status == 'active' && b.role == 'teacher' && a.principal is bool)
        // mark a student as trusted (may publish courses for the AI)
        || (onlyChanged(['trusted']) && b.status == 'active' && b.role != 'teacher' && a.trusted is bool)
        // temporary mute (a student can't write for a while, 7 days at most)
        || (onlyChanged(['muted_until']) && b.status == 'active' && b.role != 'teacher'
            && (a.muted_until == null || (a.muted_until is timestamp && a.muted_until < request.time + duration.value(7, 'd'))))
        // a deputy stands in for the delegate (30 days at most)
        || (onlyChanged(['acting_until']) && b.status == 'active' && b.role == 'deputy'
            && (a.acting_until == null || (a.acting_until is timestamp && a.acting_until < request.time + duration.value(30, 'd'))))
      );
    }

    match /users/{userId} {
      allow get: if signedIn() && (userId == uid()
        || (exists(userPath(uid())) && me().class_id != null && resource.data.class_id == me().class_id));
      allow list: if signedIn() && exists(userPath(uid())) && me().class_id != null && resource.data.class_id == me().class_id;
      allow create: if signedIn() && userId == uid() && userKeys()
        && request.resource.data.class_id == null && request.resource.data.role == 'student'
        && request.resource.data.status == 'none' && request.resource.data.created_at == request.time
        && notTrusted(request.resource.data) && notPrincipal(request.resource.data)
        && str(request.resource.data.display_name, 1, 40) && str(request.resource.data.public_key, 50, 400)
        && validColor(request.resource.data.color)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid();
      allow update: if signedIn() && (selfUpdate(userId) || delegateUpdate(userId));
      allow delete: if signedIn() && userId == uid() && resource.data.class_id == null;
    }

    // ---------------------------------------------------------------- invites
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[A-Z0-9]{4}-[A-Z0-9]{4}$')
        && request.resource.data.keys().hasOnly(['class_id', 'role'])
        && request.resource.data.get('role', 'student') in ['student', 'teacher']
        && (isDelegate(request.resource.data.class_id)
            || (!exists(classPath(request.resource.data.class_id))
                && getAfter(classPath(request.resource.data.class_id)).data.created_by == uid()));
      allow delete: if signedIn() && isDelegate(resource.data.class_id);
      allow update: if false;
    }

    // ---------------------------------------------------------------- classes
    match /classes/{cid} {
      allow get: if signedIn() && exists(userPath(uid())) && me().class_id == cid;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'invite_code', 'key_epoch', 'created_by', 'created_at'])
        && request.resource.data.created_by == uid() && request.resource.data.key_epoch == 1
        && request.resource.data.created_at == request.time && str(request.resource.data.name, 2, 60)
        && me().class_id == null
        && getAfter(userPath(uid())).data.class_id == cid
        && existsAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite_code));
      allow update: if (isTeacher(cid) && onlyChanged(['slow']) && request.resource.data.slow is int
                         && request.resource.data.slow >= 0 && request.resource.data.slow <= 600)
        || isDelegate(cid) && (
        (onlyChanged(['name']) && str(request.resource.data.name, 2, 60))
        || (onlyChanged(['invite_code']) && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite_code)).data.class_id == cid)
        // the teachers' code moved to secrets/codes: it can only be removed from here
        || (onlyChanged(['teacher_code']) && !('teacher_code' in request.resource.data))
        || (onlyChanged(['key_epoch']) && request.resource.data.key_epoch == resource.data.key_epoch + 1)
        // slow mode, in seconds between two messages of a student (0 = off)
        || (onlyChanged(['slow']) && request.resource.data.slow is int && request.resource.data.slow >= 0 && request.resource.data.slow <= 600)
        // Monday of a "semaine A" (timetables alternating A / B weeks)
        || (onlyChanged(['week_a']) && request.resource.data.week_a is string
            && request.resource.data.week_a.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'))
      );
      allow delete: if false;

      // Class keys, wrapped (encrypted) for each member.
      match /shares/{shareId} {
        allow read: if isActiveMember(cid);
        allow create: if isActiveMember(cid)
          && request.resource.data.keys().hasOnly(['epoch', 'user_id', 'from_user_id', 'from_public_key', 'iv', 'wrapped'])
          && shareId == string(request.resource.data.epoch) + '_' + request.resource.data.user_id
          && request.resource.data.from_user_id == uid()
          && request.resource.data.from_public_key == me().public_key
          && str(request.resource.data.wrapped, 10, 200) && str(request.resource.data.iv, 10, 32)
          && getAfter(userPath(request.resource.data.user_id)).data.class_id == cid
          && getAfter(userPath(request.resource.data.user_id)).data.status == 'active'
          && (exists(/databases/$(database)/documents/classes/$(cid)/shares/$(string(request.resource.data.epoch) + '_' + uid()))
              || (isDelegate(cid) && request.resource.data.epoch == getAfter(classPath(cid)).data.key_epoch));
        allow update: if false;
        allow delete: if isActiveMember(cid) && (resource.data.user_id == uid() || isDelegate(cid));
      }

      // Delegates only: the teachers' invite code (the class document itself is readable by every member).
      match /secrets/{docId} {
        allow read: if isDelegate(cid);
        allow create, update: if isDelegate(cid) && docId == 'codes'
          && request.resource.data.keys().hasOnly(['teacher_code'])
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.teacher_code)).data.class_id == cid
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.teacher_code)).data.role == 'teacher';
        allow delete: if false;
      }

      // "Mode lent" (slow mode) when a discussion heats up: students wait N seconds between messages.
      function slowSecs(cid) { return isStaff(cid) || get(classPath(cid)).data.get('slow', 0) < 1 ? 1 : get(classPath(cid)).data.slow; }
      // Muted by a delegate: can't write in the channels until then.
      function notMuted() { return !(me().get('muted_until', null) is timestamp && me().muted_until > request.time); }

      // Anti-spam: one message per second per member, enforced server-side.
      match /rate/{userId} {
        allow read: if false;
        allow create, update: if isActiveMember(cid) && userId == uid()
          && request.resource.data.keys().hasOnly(['last']) && request.resource.data.last == request.time
          && (!exists(/databases/$(database)/documents/classes/$(cid)/rate/$(uid()))
              || request.time > resource.data.last + duration.value(slowSecs(cid), 's'));
      }

      // Every moderation action on a message is written in the moderation log in the same batch.
      function logged(id) {
        return existsAfter(/databases/$(database)/documents/classes/$(cid)/modlog/$(id))
          && getAfter(/databases/$(database)/documents/classes/$(cid)/modlog/$(id)).data.by == uid();
      }

      // Changes to an existing message. Every piece is computed once: Firestore stops a rule after 1 000 operations.
      function messageUpdate(ch, mid) {
        let role = me().role;
        let active = isActiveMember(cid);
        let can = active && ((ch == 'messages' && role != 'teacher') || (ch == 'staff_messages' && role == 'teacher')
          || ch in ['mixed_messages', 'announcements']);
        let mod = active && ((ch == 'messages' && role in ['delegate', 'deputy']) || (ch == 'staff_messages' && role == 'teacher')
          || (ch in ['mixed_messages', 'announcements'] && role in ['delegate', 'deputy', 'teacher']));
        let d = request.resource.data;
        let r = resource.data;
        let alive = !('deleted_at' in r);
        let keys = d.diff(r).affectedKeys();
        // Pin / unpin (moderators, written in the moderation log)
        return (mod && keys.hasOnly(['pinned']) && d.pinned is bool && logged(mid + '_pin'))
          // Deletion is "soft": the message disappears for everyone but stays (encrypted) 30 days as evidence.
          || (can && alive && (r.user_id == uid() || (mod && logged(mid + '_del')))
              && keys.hasOnly(['deleted_at', 'deleted_by', 'pinned'])
              && d.deleted_at == request.time && d.deleted_by == uid() && d.pinned == false)
          // Emoji reactions: each member only adds / changes / removes their own.
          || (can && alive && keys.hasOnly(['reactions']) && d.reactions is map && d.reactions.size() <= 200
              && d.reactions.diff(r.get('reactions', {})).affectedKeys().hasOnly([uid()])
              && (!(uid() in d.reactions)
                  || d.reactions[uid()] in ['👍', '❤️', '😂', '😮', '😢', '🔥', '🎉', '🚀',
                       '👏', '🙏', '💯', '😍', '🤔', '😡', '😭', '🥳', '😎', '🤯', '👀', '✅', '❌', '💀', '🫡', '🤝',
                       '💪', '⭐', '💜', '💙', '🍕', '☕', '😴', '🤡', '🙈', '🥲', '😅', '🤣', '👌', '✨', '🪐', '🌙']))
          // Poll: each member votes for one option (and may change or take back their vote).
          || (can && alive && r.get('kind', '') == 'poll' && keys.hasOnly(['votes']) && d.votes is map && d.votes.size() <= 200
              && d.votes.diff(r.get('votes', {})).affectedKeys().hasOnly([uid()])
              && (!(uid() in d.votes) || (d.votes[uid()] is int && d.votes[uid()] >= 0 && d.votes[uid()] < 10)))
          // Editing: the author, within 15 minutes, same key (a harassing message can't be rewritten much later).
          || (can && alive && r.user_id == uid() && keys.hasOnly(['iv', 'ciphertext', 'edited_at']) && d.edited_at == request.time
              && request.time < r.created_at + duration.value(15, 'm')
              && str(d.iv, 10, 32) && str(d.ciphertext, 10, 60000));
      }

      // Encrypted messages, one collection per channel (students / teachers / everyone / announcements).
      match /{channel}/{mid} {
        allow read: if isChannel(channel) && canChannel(cid, channel);
        allow create: if isChannel(channel) && canPost(cid, channel, request.resource.data)
          && request.resource.data.keys().hasOnly(['user_id', 'epoch', 'iv', 'ciphertext', 'pinned', 'created_at', 'kind', 'expire_at'])
          && request.resource.data.get('kind', 'alert') in ['alert', 'poll']
          // Ephemeral message: hidden after at most 7 days (still kept encrypted 30 days more as evidence).
          && (!('expire_at' in request.resource.data) || (request.resource.data.expire_at is timestamp
              && request.resource.data.expire_at > request.time && request.resource.data.expire_at <= request.time + duration.value(7, 'd')))
          && request.resource.data.user_id == uid() && notMuted()
          && request.resource.data.epoch == get(classPath(cid)).data.key_epoch
          && request.resource.data.pinned == false
          && request.resource.data.created_at == request.time
          && str(request.resource.data.iv, 10, 32) && str(request.resource.data.ciphertext, 10, 60000)
          && getAfter(/databases/$(database)/documents/classes/$(cid)/rate/$(uid())).data.last == request.time;
        allow update: if isChannel(channel) && messageUpdate(channel, mid);
        // Permanent removal only once the 30-day retention period is over (after deletion, or after an ephemeral message expired).
        allow delete: if isChannel(channel) && canChannel(cid, channel) && (
          ('deleted_at' in resource.data && resource.data.deleted_at < request.time - duration.value(30, 'd'))
          || ('expire_at' in resource.data && resource.data.expire_at < request.time - duration.value(30, 'd')));
      }

      // Harassment reports: evidence decrypted by the reporter's device, kept 30 days.
      // Visible to the moderators of the channel it comes from (never to members who can't read that channel).
      match /reports/{rid} {
        function validEvidence(items) { return items is list && items.size() >= 1 && items.size() <= 25; }
        allow read: if isActiveMember(cid)
          && (resource.data.reporter_id == uid() || handlesReports(cid, resource.data.channel));
        allow create: if isActiveMember(cid)
          && request.resource.data.keys().hasOnly(['reporter_id', 'reported_id', 'message_id', 'reason', 'comment',
               'evidence', 'status', 'handled_by', 'created_at', 'expire_at', 'channel'])
          && isChannel(request.resource.data.channel) && canChannel(cid, request.resource.data.channel)
          && request.resource.data.reporter_id == uid()
          && request.resource.data.reported_id is string
          && request.resource.data.reason in ['harcelement', 'insulte', 'menace', 'contenu_choquant', 'usurpation', 'autre']
          && str(request.resource.data.comment, 0, 1000)
          && validEvidence(request.resource.data.evidence)
          && request.resource.data.status == 'open' && request.resource.data.handled_by == null
          && request.resource.data.created_at == request.time
          && request.resource.data.expire_at is timestamp
          && request.resource.data.expire_at > request.time + duration.value(29, 'd')
          && request.resource.data.expire_at < request.time + duration.value(31, 'd');
        allow update: if handlesReports(cid, resource.data.channel) && resource.data.reported_id != uid()
          && onlyChanged(['status', 'handled_by'])
          && request.resource.data.status in ['open', 'handled'] && request.resource.data.handled_by == uid();
        allow delete: if isActiveMember(cid) && resource.data.expire_at < request.time;
      }

      // Course library for the revision AI (encrypted like messages). Delegates and trusted members publish.
      match /courses/{courseId} {
        allow read: if isActiveMember(cid);
        allow create: if canPublishCourses(cid)
          && request.resource.data.keys().hasOnly(['uploader_id', 'epoch', 'iv', 'ciphertext', 'created_at'])
          && request.resource.data.uploader_id == uid()
          && request.resource.data.epoch == get(classPath(cid)).data.key_epoch
          && request.resource.data.created_at == request.time
          && str(request.resource.data.iv, 10, 32) && str(request.resource.data.ciphertext, 10, 60000);
        allow update: if false;
        allow delete: if isActiveMember(cid) && (resource.data.uploader_id == uid() || isDelegate(cid));
      }

      // Class council results. Each record is end-to-end encrypted for the student concerned, the teachers and the
      // delegates only: other students and the server cannot read it. Teachers and delegates write.
      match /council/{rid} {
        function isCouncilStaff() { return isTeacher(cid) || isDelegate(cid); }
        function validRecord(d) {
          return d.keys().hasOnly(['student_id', 'period', 'author_id', 'updated_at', 'iv', 'ciphertext', 'keys'])
            && d.student_id is string && d.period in ['T1', 'T2', 'T3']
            && rid == d.period + '_' + d.student_id
            && d.author_id == uid() && d.updated_at == request.time
            && str(d.iv, 10, 32) && str(d.ciphertext, 10, 20000)
            && d.keys is map && d.keys.size() >= 1 && d.keys.size() <= 80
            && get(userPath(d.student_id)).data.class_id == cid
            && get(userPath(d.student_id)).data.role != 'teacher';
        }
        allow read: if isCouncilStaff() || (isActiveMember(cid) && resource.data.student_id == uid());
        allow create, update: if isCouncilStaff() && validRecord(request.resource.data);
        allow delete: if isCouncilStaff();
      }

      // Profiles, end-to-end encrypted with the class key.
      function validProfileDoc(d, max) {
        return d.keys().hasOnly(['epoch', 'iv', 'ciphertext', 'updated_by', 'updated_at'])
          && d.epoch == get(classPath(cid)).data.key_epoch
          && d.updated_by == uid() && d.updated_at == request.time
          && str(d.iv, 10, 32) && str(d.ciphertext, 10, max);
      }
      // Photo + bio: visible to the whole class, written by the person only.
      match /profiles/{userId} {
        allow read: if isActiveMember(cid);
        allow create, update: if isActiveMember(cid) && userId == uid() && validProfileDoc(request.resource.data, 200000);
        allow delete: if isActiveMember(cid) && (userId == uid() || isDelegate(cid));
      }
      // Real name ("vrai nom"): seen and set by the person, the teachers and the delegates (class council).
      match /names/{userId} {
        function namesStaff() { return isTeacher(cid) || isDelegate(cid); }
        allow read: if (isActiveMember(cid) && userId == uid()) || namesStaff();
        allow create, update: if ((isActiveMember(cid) && userId == uid())
            || (namesStaff() && get(userPath(userId)).data.class_id == cid))
          && validProfileDoc(request.resource.data, 2000);
        allow delete: if (isActiveMember(cid) && userId == uid()) || namesStaff();
      }

      // Encrypted media, split into ~900 KB chunks.
      match /chunks/{chunkId} {
        allow read: if isActiveMember(cid);
        allow create: if isActiveMember(cid)
          && request.resource.data.keys().hasOnly(['uploader', 'n', 'data'])
          && request.resource.data.uploader == uid()
          && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n < 20
          && request.resource.data.data is bytes && request.resource.data.data.size() <= 950000;
        allow update: if false;
        allow delete: if isActiveMember(cid) && (resource.data.uploader == uid() || isDelegate(cid));
      }

      // "Contacter les délégués": one private conversation per student with the delegates (+ the head teachers if the
      // student invites them). Each conversation has its own key, wrapped for its participants only.
      match /threads/{sid} {
        function canSeeThread(d) {
          return isActiveMember(cid) && (sid == uid() || isDelegate(cid)
            || (isPrincipal(cid) && d.get('include_principal', false) == true));
        }
        function validThread(d) {
          return d.keys().hasOnly(['student_id', 'include_principal', 'keys', 'last_at', 'last_by', 'updated_at'])
            && d.student_id == sid && d.include_principal is bool
            && d.keys is map && d.keys.size() >= 1 && d.keys.size() <= 30
            && d.last_at is timestamp && d.updated_at == request.time
            && get(userPath(sid)).data.class_id == cid;
        }
        // Written out (not via canSeeThread) so a student may check that their conversation doesn't exist yet.
        allow read: if isActiveMember(cid) && (sid == uid() || isDelegate(cid)
          || (isPrincipal(cid) && resource.data.get('include_principal', false) == true));
        // The student opens it (or a delegate writes first to a student).
        allow create: if isActiveMember(cid) && (sid == uid() || isDelegate(cid))
          && validThread(request.resource.data) && request.resource.data.last_by == uid();
        allow update: if canSeeThread(resource.data) && validThread(request.resource.data)
          && request.resource.data.last_by in [resource.data.last_by, uid()]
          // Only the student decides whether the head teachers are included.
          && (request.resource.data.include_principal == resource.data.include_principal || sid == uid());
        allow delete: if false;

        match /dm/{mid} {
          function thread() { return get(/databases/$(database)/documents/classes/$(cid)/threads/$(sid)).data; }
          allow read: if canSeeThread(thread());
          allow create: if canSeeThread(thread())
            && request.resource.data.keys().hasOnly(['user_id', 'iv', 'ciphertext', 'created_at'])
            && request.resource.data.user_id == uid() && request.resource.data.created_at == request.time
            && str(request.resource.data.iv, 10, 32) && str(request.resource.data.ciphertext, 10, 60000);
          allow update, delete: if false;
        }
      }

      // Countdowns (holidays, tests, trips): added by delegates, deputies and teachers.
      match /events/{eid} {
        function validEvent(d) {
          return d.keys().hasOnly(['title', 'date', 'kind', 'author_id', 'created_at'])
            && str(d.title, 2, 60) && d.kind in ['vacances', 'controle', 'sortie', 'autre']
            && d.date is string && d.date.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            && d.author_id == uid() && d.created_at == request.time;
        }
        allow read: if isActiveMember(cid);
        allow create: if (isDelegate(cid) || isDeputy(cid) || isTeacher(cid)) && validEvent(request.resource.data);
        allow update: if false;
        allow delete: if isDelegate(cid) || isDeputy(cid) || isTeacher(cid);
      }

      // Encrypted content of the "class items" (alerts, compliments, playlist…): current key, sensible sizes.
      function sealed(d, max) {
        return d.epoch == get(classPath(cid)).data.key_epoch && str(d.iv, 10, 32) && str(d.ciphertext, 10, max);
      }
      function isDate(v) { return v is string && v.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }

      // Timetable alerts ("prof absent", "salle changée", "cours annulé"): any member warns the class.
      match /alerts/{aid} {
        allow read: if isActiveMember(cid);
        allow create: if isActiveMember(cid)
          && request.resource.data.keys().hasOnly(['kind', 'slot_id', 'date', 'epoch', 'iv', 'ciphertext', 'by', 'created_at'])
          && request.resource.data.kind in ['absent', 'room', 'cancel'] && isDate(request.resource.data.date)
          && request.resource.data.slot_id is string && request.resource.data.by == uid()
          && request.resource.data.created_at == request.time && sealed(request.resource.data, 2000);
        allow update: if false;
        allow delete: if isActiveMember(cid) && (resource.data.by == uid() || isStaff(cid));
      }

      // Scheduled messages: encrypted by their author when written, moved into the channel at the chosen time by the
      // notification server (which still can't read them). Only the author sees or cancels them.
      match /scheduled/{sid} {
        allow read, delete: if signedIn() && resource.data.user_id == uid();
        allow create: if isActiveMember(cid)
          && request.resource.data.keys().hasOnly(['user_id', 'channel', 'epoch', 'iv', 'ciphertext', 'send_at', 'created_at'])
          && request.resource.data.user_id == uid()
          && isChannel(request.resource.data.channel) && canPost(cid, request.resource.data.channel, request.resource.data)
          && request.resource.data.epoch == get(classPath(cid)).data.key_epoch
          && str(request.resource.data.iv, 10, 32) && str(request.resource.data.ciphertext, 10, 60000)
          && request.resource.data.send_at is timestamp && request.resource.data.send_at > request.time
          && request.resource.data.send_at < request.time + duration.value(24, 'd')
          && request.resource.data.created_at == request.time;
        allow update: if false;
      }

      // ------------------------------------------------ class life (fun)
      // Personal counters (XP, streak, badges, weekly challenges): written by the member only, seen by the class.
      match /stats/{userId} {
        function count(v) { return v is int && v >= 0 && v <= 10000000; }
        allow read: if isActiveMember(cid);
        allow create, update: if isActiveMember(cid) && userId == uid()
          && request.resource.data.keys().hasOnly(['xp', 'streak', 'best_streak', 'last_day', 'week', 'w', 'total', 'badges', 'updated_at'])
          && count(request.resource.data.xp) && count(request.resource.data.streak) && count(request.resource.data.best_streak)
          && count(request.resource.data.last_day) && count(request.resource.data.week)
          && request.resource.data.w is map && request.resource.data.w.size() <= 20
          && request.resource.data.total is map && request.resource.data.total.size() <= 20
          && request.resource.data.badges is list && request.resource.data.badges.size() <= 60
          && request.resource.data.updated_at == request.time;
        allow delete: if isActiveMember(cid) && userId == uid();
      }

      // Compliments, playlist, class journal: encrypted posts with likes.
      match /board/{bid} {
        allow read: if isActiveMember(cid);
        allow create: if isActiveMember(cid)
          && request.resource.data.keys().hasOnly(['kind', 'by', 'to', 'month', 'epoch', 'iv', 'ciphertext', 'created_at'])
          && request.resource.data.kind in ['compliment', 'song', 'memory'] && request.resource.data.by == uid()
          && request.resource.data.get('to', '') is string && request.resource.data.get('month', '') is string
          && request.resource.data.created_at == request.time && sealed(request.resource.data, 300000);
        allow update: if isActiveMember(cid) && onlyChanged(['likes']) && request.resource.data.likes is map
          && request.resource.data.likes.diff(resource.data.get('likes', {})).affectedKeys().hasOnly([uid()])
          && (!(uid() in request.resource.data.likes) || request.resource.data.likes[uid()] == true);
        allow delete: if isActiveMember(cid)
          && (resource.data.by == uid() || resource.data.get('to', '') == uid() || isStaff(cid));
      }

      // Time capsule: sealed until its opening date (only its author can read it before).
      match /capsules/{capid} {
        allow read: if isActiveMember(cid) && (resource.data.by == uid() || request.time >= resource.data.open_at);
        allow create: if isActiveMember(cid)
          && request.resource.data.keys().hasOnly(['by', 'open_at', 'epoch', 'iv', 'ciphertext', 'created_at'])
          && request.resource.data.by == uid() && request.resource.data.created_at == request.time
          && request.resource.data.open_at is timestamp && request.resource.data.open_at > request.time + duration.value(1, 'd')
          && request.resource.data.open_at < request.time + duration.value(400, 'd')
          && sealed(request.resource.data, 60000);
        allow update: if false;
        allow delete: if isActiveMember(cid) && (resource.data.by == uid() || isDelegate(cid));
      }
      // Capsules waiting to be opened: only their author and date (the content stays sealed above).
      match /capsule_dates/{capid} {
        allow read: if isActiveMember(cid);
        allow create: if isActiveMember(cid) && request.resource.data.keys().hasOnly(['by', 'open_at'])
          && request.resource.data.by == uid()
          && request.resource.data.open_at == getAfter(/databases/$(database)/documents/classes/$(cid)/capsules/$(capid)).data.open_at
          && getAfter(/databases/$(database)/documents/classes/$(cid)/capsules/$(capid)).data.by == uid();
        allow update: if false;
        allow delete: if isActiveMember(cid) && (resource.data.by == uid() || isDelegate(cid));
      }

      // Birthday card signed by the class: hidden from the birthday person until the day.
      match /cards/{cardId} {
        function signOnly() {
          return onlyChanged(['signatures']) && request.resource.data.signatures is map
            && request.resource.data.signatures.diff(resource.data.signatures).affectedKeys().hasOnly([uid()])
            && (!(uid() in request.resource.data.signatures)
                || (str(request.resource.data.signatures[uid()].iv, 10, 32) && str(request.resource.data.signatures[uid()].ciphertext, 10, 3000)
                    && request.resource.data.signatures[uid()].keys().hasOnly(['iv', 'ciphertext'])));
        }
        allow get: if isActiveMember(cid) && (resource.data.target != uid() || request.time >= resource.data.open_at);
        allow list: if isActiveMember(cid) && resource.data.target != uid();
        allow create: if isActiveMember(cid) && request.resource.data.keys().hasOnly(['target', 'open_at', 'epoch', 'signatures'])
          && request.resource.data.target != uid() && cardId == request.resource.data.target + '_' + string(request.resource.data.open_at.year())
          && get(userPath(request.resource.data.target)).data.class_id == cid
          && request.resource.data.open_at is timestamp && request.resource.data.open_at < request.time + duration.value(370, 'd')
          && request.resource.data.epoch == get(classPath(cid)).data.key_epoch
          && request.resource.data.signatures is map && request.resource.data.signatures.size() == 0;
        allow update: if isActiveMember(cid) && resource.data.target != uid() && signOnly();
        allow delete: if isDelegate(cid);
      }

      // End-of-year awards ("le plus drôle"…): the delegates open categories, everyone votes for one member.
      match /awards/{aid} {
        allow read: if isActiveMember(cid);
        allow create: if isDelegate(cid) && request.resource.data.keys().hasOnly(['title', 'open', 'votes', 'created_at'])
          && str(request.resource.data.title, 2, 60) && request.resource.data.open == true
          && request.resource.data.votes is map && request.resource.data.votes.size() == 0
          && request.resource.data.created_at == request.time;
        allow update: if (isDelegate(cid) && onlyChanged(['open']) && request.resource.data.open is bool)
          || (isActiveMember(cid) && resource.data.open == true && onlyChanged(['votes'])
              && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([uid()])
              && (!(uid() in request.resource.data.votes)
                  || (request.resource.data.votes[uid()] is string && request.resource.data.votes[uid()] != uid()
                      && get(userPath(request.resource.data.votes[uid()])).data.class_id == cid)));
        allow delete: if isDelegate(cid);
      }

      // Two-player mini-games (tic-tac-toe, connect four, rock-paper-scissors). Boards aren't secret.
      match /games/{gid} {
        function players() { return resource.data.players; }
        allow read: if isActiveMember(cid);
        allow create: if isActiveMember(cid)
          && request.resource.data.keys().hasOnly(['kind', 'players', 'turn', 'board', 'winner', 'commits', 'reveals', 'created_at', 'updated_at'])
          && request.resource.data.kind in ['ttt', 'c4', 'rps']
          && request.resource.data.players is list && request.resource.data.players.size() == 2
          && request.resource.data.players[0] == uid() && request.resource.data.players[1] != uid()
          && get(userPath(request.resource.data.players[1])).data.class_id == cid
          && request.resource.data.winner == '' && request.resource.data.created_at == request.time
          && request.resource.data.updated_at == request.time && str(request.resource.data.board, 0, 64);
        allow update: if isActiveMember(cid) && uid() in players() && resource.data.winner == ''
          && request.resource.data.updated_at == request.time
          && (
            // board games: the player whose turn it is plays, then it's the other one's turn
            (resource.data.kind in ['ttt', 'c4'] && resource.data.turn == uid()
              && onlyChanged(['board', 'turn', 'winner', 'updated_at']) && str(request.resource.data.board, 9, 64)
              && request.resource.data.turn in players() && request.resource.data.turn != uid()
              && request.resource.data.winner is string)
            // rock-paper-scissors: a hidden choice first (hash), then revealed once both chose
            || (resource.data.kind == 'rps' && onlyChanged(['commits', 'updated_at'])
              && request.resource.data.commits.diff(resource.data.commits).affectedKeys().hasOnly([uid()])
              && !(uid() in resource.data.commits) && str(request.resource.data.commits[uid()], 64, 64))
            || (resource.data.kind == 'rps' && resource.data.commits.size() == 2 && onlyChanged(['reveals', 'winner', 'updated_at'])
              && request.resource.data.reveals.diff(resource.data.reveals).affectedKeys().hasOnly([uid()])
              && str(request.resource.data.reveals[uid()], 3, 80) && request.resource.data.winner is string)
            // giving up
            || (onlyChanged(['winner', 'updated_at']) && request.resource.data.winner in players() && request.resource.data.winner != uid())
          );
        allow delete: if isActiveMember(cid) && (uid() in resource.data.players || isStaff(cid));
      }

      // Live quiz (Kahoot-like): the host runs it, answers are timed by the server clock.
      match /quizzes/{qid} {
        allow read: if isActiveMember(cid);
        allow create: if isActiveMember(cid)
          && request.resource.data.keys().hasOnly(['host', 'title', 'epoch', 'iv', 'ciphertext', 'count', 'phase', 'index', 'started_at', 'answer', 'created_at'])
          && request.resource.data.host == uid() && request.resource.data.phase == 'lobby' && request.resource.data.index == -1
          && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 30
          && str(request.resource.data.title, 2, 80) && request.resource.data.created_at == request.time
          && sealed(request.resource.data, 60000);
        allow update: if isActiveMember(cid) && resource.data.host == uid()
          && onlyChanged(['phase', 'index', 'started_at', 'answer'])
          && request.resource.data.phase in ['lobby', 'question', 'reveal', 'end']
          && request.resource.data.index is int && request.resource.data.index < resource.data.count
          && (request.resource.data.phase != 'question' || request.resource.data.started_at == request.time);
        allow delete: if isActiveMember(cid) && (resource.data.host == uid() || isStaff(cid));
        match /answers/{aid} {
          function quiz() { return get(/databases/$(database)/documents/classes/$(cid)/quizzes/$(qid)).data; }
          allow read: if isActiveMember(cid);
          allow create: if isActiveMember(cid) && aid == uid() + '_' + string(request.resource.data.index)
            && request.resource.data.keys().hasOnly(['uid', 'index', 'choice', 'at'])
            && request.resource.data.uid == uid() && request.resource.data.at == request.time
            && request.resource.data.choice is int && request.resource.data.choice >= 0 && request.resource.data.choice < 6
            && quiz().phase == 'question' && request.resource.data.index == quiz().index
            && request.time < quiz().started_at + duration.value(25, 's');
          allow update, delete: if false;
        }
      }

      // ------------------------------------------------ class organisation
      // Who brings what, kitty tracking, lost & found, council minutes (encrypted).
      match /org/{oid} {
        allow read: if isActiveMember(cid);
        allow create: if isActiveMember(cid)
          && request.resource.data.keys().hasOnly(['kind', 'by', 'claims', 'paid', 'status', 'epoch', 'iv', 'ciphertext', 'created_at'])
          && request.resource.data.kind in ['list', 'kitty', 'lost', 'minutes']
          && (request.resource.data.kind != 'minutes' || isDelegate(cid) || isTeacher(cid))
          && request.resource.data.by == uid() && request.resource.data.created_at == request.time
          && request.resource.data.get('claims', {}) is map && request.resource.data.get('claims', {}).size() == 0
          && request.resource.data.get('paid', {}) is map && request.resource.data.get('paid', {}).size() == 0
          && request.resource.data.get('status', 'open') == 'open'
          && sealed(request.resource.data, 200000);
        allow update: if isActiveMember(cid) && (
          // "I bring it": each member only changes their own list of items
          (resource.data.kind == 'list' && onlyChanged(['claims'])
            && request.resource.data.claims.diff(resource.data.claims).affectedKeys().hasOnly([uid()])
            && request.resource.data.claims[uid()] is list && request.resource.data.claims[uid()].size() <= 20)
          // the organiser ticks who paid
          || (resource.data.kind == 'kitty' && resource.data.by == uid() && onlyChanged(['paid']) && request.resource.data.paid.size() <= 100)
          // lost object found / given back
          || (resource.data.kind == 'lost' && (resource.data.by == uid() || isStaff(cid)) && onlyChanged(['status'])
            && request.resource.data.status == 'done'));
        allow delete: if isActiveMember(cid) && (resource.data.by == uid() || isStaff(cid));
      }

      // Personal reminders: pushed at the chosen time by the notification server. Only their owner sees them.
      match /reminders/{rid} {
        allow read, delete: if signedIn() && resource.data.user_id == uid();
        allow create: if isActiveMember(cid)
          && request.resource.data.keys().hasOnly(['user_id', 'at', 'epoch', 'iv', 'ciphertext', 'created_at'])
          && request.resource.data.user_id == uid() && request.resource.data.created_at == request.time
          && request.resource.data.at is timestamp && request.resource.data.at > request.time
          && request.resource.data.at < request.time + duration.value(24, 'd')
          && sealed(request.resource.data, 2000);
        allow update: if false;
      }

      // Anonymous posts: no author is stored. The anti-spam document written in the same batch limits flooding.
      function anonymousPost(max) {
        return isActiveMember(cid) && request.resource.data.keys().hasOnly(['epoch', 'iv', 'ciphertext', 'created_at'])
          && request.resource.data.created_at == request.time && sealed(request.resource.data, max)
          && getAfter(/databases/$(database)/documents/classes/$(cid)/rate/$(uid())).data.last == request.time;
      }
      // Idea box: read by the delegates and the teachers only.
      match /ideas/{iid} {
        allow read: if isDelegate(cid) || isTeacher(cid);
        allow create: if anonymousPost(4000);
        allow update: if false;
        allow delete: if isDelegate(cid);
      }
      // Anonymous questions to the teachers; the answers are signed and visible to the class.
      match /questions/{qid} {
        allow read: if isActiveMember(cid);
        allow create: if anonymousPost(4000);
        allow update: if isTeacher(cid) && !('answer_ct' in resource.data)
          && onlyChanged(['answer_epoch', 'answer_iv', 'answer_ct', 'answered_by'])
          && request.resource.data.answered_by == uid()
          && request.resource.data.answer_epoch == get(classPath(cid)).data.key_epoch
          && str(request.resource.data.answer_iv, 10, 32) && str(request.resource.data.answer_ct, 10, 6000);
        allow delete: if isTeacher(cid) || isDelegate(cid);
      }

      // Questionnaires (before the class council, satisfaction…): created by delegates / teachers.
      match /surveys/{sid} {
        allow read: if isActiveMember(cid);
        allow create: if (isDelegate(cid) || isTeacher(cid))
          && request.resource.data.keys().hasOnly(['by', 'anonymous', 'open', 'epoch', 'iv', 'ciphertext', 'created_at'])
          && request.resource.data.by == uid() && request.resource.data.anonymous is bool && request.resource.data.open == true
          && request.resource.data.created_at == request.time && sealed(request.resource.data, 20000);
        allow update: if (resource.data.by == uid() || isDelegate(cid)) && isActiveMember(cid)
          && onlyChanged(['open']) && request.resource.data.open is bool;
        allow delete: if resource.data.by == uid() || isDelegate(cid);
        match /answers/{aid} {
          function survey() { return get(/databases/$(database)/documents/classes/$(cid)/surveys/$(sid)).data; }
          // Results: the author of the questionnaire and the delegates (anonymous answers carry no name).
          allow read: if survey().by == uid() || isDelegate(cid) || (!survey().anonymous && aid == uid() && isActiveMember(cid));
          allow create: if isActiveMember(cid) && survey().open == true
            && request.resource.data.keys().hasOnly(['epoch', 'iv', 'ciphertext', 'created_at'])
            && request.resource.data.created_at == request.time && sealed(request.resource.data, 20000)
            && (survey().anonymous || aid == uid());
          allow update: if false;
          allow delete: if survey().by == uid() || isDelegate(cid);
        }
      }

      // ------------------------------------------------ revision
      // Flashcard decks generated from the courses, shared with the class (encrypted).
      match /decks/{did} {
        allow read: if isActiveMember(cid);
        allow create: if isActiveMember(cid)
          && request.resource.data.keys().hasOnly(['by', 'count', 'epoch', 'iv', 'ciphertext', 'created_at'])
          && request.resource.data.by == uid() && request.resource.data.count is int && request.resource.data.count <= 60
          && request.resource.data.created_at == request.time && sealed(request.resource.data, 200000);
        allow update: if false;
        allow delete: if isActiveMember(cid) && (resource.data.by == uid() || isStaff(cid));
      }
      // "On révise ensemble": one shared Pomodoro timer for the class.
      match /study_room/{rid} {
        function validRoom(d) {
          return d.keys().hasOnly(['by', 'focus', 'pause', 'rounds', 'start', 'people', 'updated_at'])
            && d.by == uid() && d.focus is int && d.focus >= 5 && d.focus <= 90 && d.pause is int && d.pause >= 1 && d.pause <= 30
            && d.rounds is int && d.rounds >= 1 && d.rounds <= 8
            && d.start is int && d.start > request.time.toMillis() - 60000 && d.start < request.time.toMillis() + 600000
            && d.people is map && d.people.keys().hasOnly([uid()]) && d.updated_at == request.time;
        }
        function ended() {
          return resource.data.start + (resource.data.focus + resource.data.pause) * resource.data.rounds * 60000 < request.time.toMillis();
        }
        allow read: if isActiveMember(cid);
        allow create: if isActiveMember(cid) && rid == 'current' && validRoom(request.resource.data);
        allow update: if isActiveMember(cid) && (
          (onlyChanged(['people', 'updated_at']) && request.resource.data.updated_at == request.time
            && request.resource.data.people.diff(resource.data.people).affectedKeys().hasOnly([uid()]))
          || (ended() && validRoom(request.resource.data)));
        allow delete: if isActiveMember(cid) && (resource.data.by == uid() || isStaff(cid) || ended());
      }

      // ------------------------------------------------ delegates' tools
      // Moderation log: who pinned, deleted, muted… Readable by the delegates and the teachers.
      match /modlog/{lid} {
        allow read: if isDelegate(cid) || isTeacher(cid);
        allow create: if isStaff(cid)
          && request.resource.data.keys().hasOnly(['action', 'target', 'channel', 'detail', 'by', 'at'])
          && request.resource.data.action in ['delete', 'pin', 'unpin', 'mute', 'unmute', 'kick', 'role', 'slow', 'filter', 'welcome', 'acting']
          && request.resource.data.by == uid() && request.resource.data.at == request.time
          && str(request.resource.data.target, 0, 128) && str(request.resource.data.channel, 0, 40) && str(request.resource.data.detail, 0, 200);
        // a message pinned / unpinned again rewrites its pin record (a deletion record is never rewritten)
        allow update: if isStaff(cid) && resource.data.action in ['pin', 'unpin']
          && request.resource.data.action in ['pin', 'unpin'] && request.resource.data.by == uid() && request.resource.data.at == request.time
          && request.resource.data.keys().hasOnly(['action', 'target', 'channel', 'detail', 'by', 'at']);
        allow delete: if false;
      }
      // Class settings: banned words (checked on the devices) and the welcome message, encrypted.
      match /settings/{sid} {
        allow read: if isActiveMember(cid);
        allow create, update: if (isDelegate(cid) || isTeacher(cid)) && sid in ['filter', 'welcome']
          && request.resource.data.keys().hasOnly(['epoch', 'iv', 'ciphertext', 'updated_by', 'updated_at'])
          && request.resource.data.updated_by == uid() && request.resource.data.updated_at == request.time
          && sealed(request.resource.data, 20000);
        allow delete: if isDelegate(cid);
      }

      // Class stickers (small encrypted images made from members' photos).
      match /stickers/{stid} {
        allow read: if isActiveMember(cid);
        allow create: if isActiveMember(cid)
          && request.resource.data.keys().hasOnly(['by', 'epoch', 'iv', 'ciphertext', 'created_at'])
          && request.resource.data.by == uid() && request.resource.data.created_at == request.time
          && sealed(request.resource.data, 80000);
        allow update: if false;
        allow delete: if isActiveMember(cid) && (resource.data.by == uid() || isStaff(cid));
      }

      match /slots/{sid} {
        allow read: if isActiveMember(cid);
        allow create, update: if isDelegate(cid) && validSlot(request.resource.data);
        allow delete: if isDelegate(cid);
      }

      // Timetable change proposals + secret ballot.
      match /proposals/{pid} {
        function votePath() { return /databases/$(database)/documents/classes/$(cid)/proposals/$(pid)/votes/$(uid()); }
        function field(v) { return {'1': 'yes', '-1': 'no', '0': 'abstain'}[string(v)]; }
        function total(d) { return d.yes + d.no + d.abstain; }
        function tallyUpdate() {
          let b = resource.data;
          let a = request.resource.data;
          let nv = getAfter(votePath()).data.value;
          return isStudent(cid) && b.status == 'open' && b.deadline > request.time
            && onlyChanged(['yes', 'no', 'abstain'])
            && existsAfter(votePath())
            && a[field(nv)] == b[field(nv)] + 1
            && ((!exists(votePath()) && total(a) == total(b) + 1)
                || (exists(votePath()) && get(votePath()).data.value != nv
                    && a[field(get(votePath()).data.value)] == b[field(get(votePath()).data.value)] - 1
                    && total(a) == total(b)));
        }

        allow read: if isActiveMember(cid);
        // Only delegates open votes (timetable changes or free questions); every member can vote.
        allow create: if isDelegate(cid)
          && request.resource.data.keys().hasOnly(['author_id', 'title', 'reason', 'action', 'slot_id', 'data', 'status',
               'yes', 'no', 'abstain', 'deadline', 'created_at', 'closed_at'])
          && request.resource.data.author_id == uid()
          && request.resource.data.status == 'open' && request.resource.data.closed_at == null
          && request.resource.data.yes == 0 && request.resource.data.no == 0 && request.resource.data.abstain == 0
          && request.resource.data.created_at == request.time
          && request.resource.data.deadline is timestamp
          && request.resource.data.deadline > request.time
          && request.resource.data.deadline < request.time + duration.value(169, 'h')
          && str(request.resource.data.title, 3, 80) && str(request.resource.data.reason, 0, 600)
          && request.resource.data.action in ['add', 'modify', 'delete', 'poll']
          && (request.resource.data.action in ['delete', 'poll'] || validSlot(request.resource.data.data))
          && (request.resource.data.action in ['add', 'poll']
              || exists(/databases/$(database)/documents/classes/$(cid)/slots/$(request.resource.data.slot_id)));
        allow update: if (isDelegate(cid) && resource.data.status == 'open' && onlyChanged(['status', 'closed_at'])
                          && request.resource.data.status in ['accepted', 'rejected']
                          && request.resource.data.closed_at == request.time)
                      || tallyUpdate();
        allow delete: if isDelegate(cid);

        match /votes/{voterId} {
          function proposal() { return /databases/$(database)/documents/classes/$(cid)/proposals/$(pid); }
          function validVote() {
            return request.resource.data.keys().hasOnly(['value']) && request.resource.data.value in [-1, 0, 1];
          }
          allow get: if signedIn() && voterId == uid();
          allow list: if false;
          // The tally must move by exactly one in the same batch.
          allow create: if signedIn() && voterId == uid() && isStudent(cid) && validVote()
            && exists(proposal()) && get(proposal()).data.status == 'open' && get(proposal()).data.deadline > request.time
            && getAfter(proposal()).data[field(request.resource.data.value)] == get(proposal()).data[field(request.resource.data.value)] + 1;
          allow update: if signedIn() && voterId == uid() && isStudent(cid) && validVote()
            && resource.data.value != request.resource.data.value
            && get(proposal()).data.status == 'open' && get(proposal()).data.deadline > request.time
            && getAfter(proposal()).data[field(request.resource.data.value)] == get(proposal()).data[field(request.resource.data.value)] + 1
            && getAfter(proposal()).data[field(resource.data.value)] == get(proposal()).data[field(resource.data.value)] - 1;
          allow delete: if false;
        }
      }
    }
  }
}
